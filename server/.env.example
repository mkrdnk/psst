# Supply secrets locally; never commit a populated .env file.
ADMIN_PASSWORD=
# Generate separately: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN=
# Generate another independent value with the same command (32 random bytes).
PASETO_SECRET_KEY=

# Exact browser origin, no trailing slash. HTTPS is required outside loopback.
PUBLIC_ORIGIN=http://localhost:8000
PING_INTERVAL_SECONDS=30
SESSION_TTL_SECONDS=43200
# Optional; the default is server/data/psst.db, independent of the working directory.
# DATABASE_PATH=/absolute/path/to/psst.db
